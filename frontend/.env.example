# URL base de la API backend. En producción DEBE ser https:// (ver RNF8) —
# Render/Railway proveen HTTPS automáticamente sobre su dominio.
VITE_API_URL=http://localhost:4000/api/v1
# Número de WhatsApp del negocio en formato internacional sin +, espacios ni guiones
# (ej. 529211234567 para México). NUNCA hardcodear este valor en el código.
VITE_WHATSAPP_NUMBER=123456789012